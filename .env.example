# Copy to .env and fill in. .env is git-ignored.

# OpenSearch (fine-grained access control, basic auth)
OPENSEARCH_ENDPOINT=https://<your-domain-endpoint>.us-east-1.es.amazonaws.com
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=<your-password>
OPENSEARCH_INDEX=<your-index>
# Default fusion pipeline: rrf-hybrid-pipeline or nlp-search-pipeline
OPENSEARCH_SEARCH_PIPELINE=rrf-hybrid-pipeline

# OpenSearch ML model (Bedrock Cohere connector) used to embed the query
ML_MODEL_ID=<your-model-id>
EMBED_INPUT_TYPE=search_query

# S3 Vectors hybrid search (beta, us-east-2 only)
S3V_REGION=us-east-2
S3V_BUCKET=<your-vector-bucket>
S3V_INDEX=<your-vector-index>
S3V_TEXT_KEY=passage_body
